{
  "set_name": "open_v1_fanar",
  "condition": "open",
  "generator": "QCRI/Fanar-1-9B-Instruct",
  "cache_dir": "F:/Thesis/models",
  "quantization": "nf4",
  "template": "prompts/open_v1.json",
  "dialects": "all",
  "per_dialect": 500,
  "sentences_per_request": 1,
  "batch_size": 8,
  "seed": 42,
  "sampling": {
    "temperature": 1.0,
    "top_p": 0.95,
    "top_k": 50,
    "max_new_tokens": 64,
    "repetition_penalty": 1.0,
    "do_sample": true
  },
  "few_shot": {"k": 0, "source": "data/processed/nadi_lahjatbert.jsonl", "max_cardinality": 1, "min_aldi": 0.5, "min_words": 4},
  "label_mode": "target_only",
  "controls": null,
  "output": "data/synthetic/open_v1_fanar.jsonl",
  "_notes": "per_dialect, label_mode and few_shot.k are PENDING user decisions; values here are placeholders for smoke tests."
}
