{
  "set_name": "backtranslate_v1_nllb_distilled",
  "condition": "backtranslation",
  "generator": "facebook/nllb-200-distilled-1.3B",
  "cache_dir": "F:/Thesis/models",
  "source": "data/processed/nadi_lahjatbert.jsonl",
  "dialects": "all",
  "per_dialect": 500,
  "seed": 42,
  "batch_size": 16,
  "pivot": "eng_Latn",
  "decoding": {"num_beams": 4, "do_sample": false, "max_length": 128},
  "selection": {"min_aldi": 0.5, "min_words": 4, "max_words": 40, "exclude_placeholders": true},
  "nllb_lang": {
    "Algeria":      {"code": "ary_Arab", "exact": false},
    "Bahrain":      {"code": "ars_Arab", "exact": false},
    "Egypt":        {"code": "arz_Arab", "exact": true},
    "Iraq":         {"code": "acm_Arab", "exact": true},
    "Jordan":       {"code": "ajp_Arab", "exact": true},
    "Kuwait":       {"code": "ars_Arab", "exact": false},
    "Lebanon":      {"code": "apc_Arab", "exact": true},
    "Libya":        {"code": "aeb_Arab", "exact": false},
    "Morocco":      {"code": "ary_Arab", "exact": true},
    "Oman":         {"code": "ars_Arab", "exact": false},
    "Palestine":    {"code": "ajp_Arab", "exact": true},
    "Qatar":        {"code": "ars_Arab", "exact": false},
    "Saudi_Arabia": {"code": "ars_Arab", "exact": true},
    "Sudan":        {"code": "arz_Arab", "exact": false},
    "Syria":        {"code": "apc_Arab", "exact": true},
    "Tunisia":      {"code": "aeb_Arab", "exact": true},
    "UAE":          {"code": "ars_Arab", "exact": false},
    "Yemen":        {"code": "acq_Arab", "exact": true}
  },
  "output": "data/synthetic/backtranslate_v1_nllb_distilled.jsonl",
  "_notes": "NLLB-200 has no code for Algeria, Libya, Sudan or the Gulf states other than Saudi (Najdi); 'exact': false marks the nearest-code fallback. per_dialect and the fallback choices are PENDING user decisions. For facebook/nllb-200-1.3B change generator and set_name."
}
