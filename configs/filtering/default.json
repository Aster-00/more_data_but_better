    "length":            {"enabled": true, "min_words": 2, "max_words": 60},
    "did_nadi":          {"enabled": true, "mode": "top1", "min_prob": 0.0},
    "did_madar":         {"enabled": false, "mode": "top1", "min_prob": 0.0},
    "aldi":              {"enabled": true, "min_score": 0.3}
  },
  "_notes": "PLACEHOLDER thresholds for smoke tests. Calibrate on D1 / dev with src.quality.measure before real use: e.g. the DID top-1 agreement on real single-label D1 texts is the ceiling a synthetic set can reach. did_madar is off by default because it cannot cover Bahrain, Kuwait and the UAE; switch it on as an ablation."
