{
  "cache_dir": "F:/Thesis/models",
  "checks": {
    "parse_ok":          {"enabled": true},
    "exact_dup_within":  {"enabled": true},
    "near_dup_within":   {"enabled": true, "threshold": 0.8, "ngram": 5},
