{
  "_doc": "Sentiment run registry (separate from configs/runs.json). A run (SR<NN>) is one fixed setup: data and training settings. Each model tried under it is a member SR<NN>-<model>. 'members' maps a result folder under results/sentiment/runs/ (with _seed<N> removed) to its run and model tag. 'run_data' gives each run on generated data its SG label and the corpus the set was generated for (D-029); real-only runs have no entry. src.sentiment.summarize_runs groups the score tables by this file.",
  "runs": {
    "SR01": "Real only (condition 1), S1 (ArSarcasm-v2), every roster classifier; BERTs 3 seeds, LLMs seed 42 first (SD-003)",
    "SR02": "Real + SG01 (open, zero-shot synthetic; condition 2): S1 train + 6,000 tweets (500 per variety x sentiment cell) from one SG01 generator; BERTs 3 seeds; Jais-2 (QLoRA, SR01 recipe) 3 seeds. Member = <classifier>_<generator>. The Jais-2 set could not fill its cells and was not trained.",
    "SR03": "Real only, NEU dropped: S1 train/dev/test without NEU tweets (6,069 / 675 / 2,252), 2-class NEG/POS head, every roster classifier, 3 seeds (SD-007). Macro F1 is over NEG/POS, not comparable with SR01/SR02.",
    "SR04": "Real + SG02 (open, few-shot k=5 synthetic; condition 2): S1 train + 6,000 tweets (500 per variety x sentiment cell) from one SG02 generator (Fanar, Qwen3, Aya); the 7 BERTs, 3 seeds, SR02 recipe (D-020). Member = <classifier>_<generator>.",
    "SR05": "Real + SG03 (targeted minimal pairs for the SR02 dev hard-case types, D-021; condition 3): S1 train + 4,000 texts (2,000 complete pairs) from one SG03 generator; 7 BERTs, 3 seeds, SR04 recipe. Member = <classifier>_<generator>.",
    "SR06": "Real + SG03-random (size-matched untargeted minimal pairs, the control for SR05, D-021): S1 train + 4,000 texts from one SG03-random generator; 7 BERTs, 3 seeds, SR04 recipe. Member = <classifier>_<generator>.",
    "SR07": "Real + SG04 (targeted minimal pairs for the SR02 TEST hard-case types, D-023: TEST-CONTAMINATED, test scores are leakage analysis, not a result): S1 train + 4,000 texts (2,000 complete pairs, fidelity-first selection, min 80%) from one SG04 generator; 7 BERTs, 3 seeds, SR05 recipe. No random control. Member = <classifier>_<generator>.",
    "SR08": "Repair test on SR07 (D-025, test-contaminated like SR07): S1 train + SG04 without the prayer pairs (3,600 texts); 3 BERTs (MARBERTv2, AraBERTv02-Tw, CAMeLBERT-mix), 3 seeds, SR07 recipe. Member = <classifier>_<generator>.",
    "SR09": "Repair test on SR07 (D-025, test-contaminated like SR07): S1 train + SG04 Qwen3 without the pairs whose sides have the same words; 3 BERTs, 3 seeds, SR07 recipe. Member = <classifier>_qwen3.",
    "SR10": "Repair test on SR07 (D-025, test-contaminated like SR07): two-stage training, epochs 1-2 on S1 train + SG04, epoch 3 on S1 train only; 3 BERTs, 3 seeds, otherwise SR07 recipe. Member = <classifier>_<generator>.",
    "SR11": "Repair test on SR07 (D-025, test-contaminated like SR07): SR08 + SR10 together: SG04 without the prayer pairs, epochs 1-2 on S1 train + the set, epoch 3 on S1 train only; 3 BERTs, 3 seeds, otherwise SR07 recipe. Member = <classifier>_<generator>.",
    "SR12": "SR11 without the NEU generations (D-026, test-contaminated like SR07): S1 train + the whole POS/NEG pairs of SG04 (sarcastic praise, emoji in context; 1,600 texts), epochs 1-2 on S1 train + the set, epoch 3 on S1 train only; 3 BERTs, 3 seeds, otherwise SR11 recipe. Member = <classifier>_<generator>.",
    "SR13": "SR12 + the NEG sides of the SG04 public jab and personal remark pairs (D-026, test-contaminated like SR07): 2,600 texts, pairs of those types broken, NEU sides dropped; otherwise SR12 recipe. SR13 - SR12 = effect of those 1,000 NEG sides. Member = <classifier>_<generator>.",
    "SR12-3600": "SR12 at the size of SR11 (D-027, test-contaminated like SR07): S1 train + SG04-PN (1,800 POS/NEG pairs, 3,600 texts, fidelity of SR12 per type), epochs 1-2 on S1 train + the set, epoch 3 on S1 train only; 3 BERTs, 3 seeds, otherwise SR11 recipe. Member = <classifier>_<generator>.",
    "SR01-EESA": "Real only on EESA (data version E2, D-032): EESA train 2,463 / dev 818 / test 818, the 7 BERTs, 3 seeds, SR01 recipe. Baseline for SR02-EESA, SR05-EESA and SR06-EESA.",
    "SR02-EESA": "EESA real + SG01-EESA (D-032): EESA train + 1,320 texts generated for EESA (prompt open_eesa_v1, 440 per sentiment, 0.54 x real as in SR02), from one generator; 7 BERTs, 3 seeds. Member = <classifier>_<generator>.",
    "SR05-EESA": "EESA real + SG03-EESA (D-032): EESA train + 880 targeted minimal-pair texts generated for EESA (440 pairs; types from SR02-EESA dev errors, agreed with Ammar); 7 BERTs, 3 seeds. Member = <classifier>_<generator>.",
    "SR06-EESA": "EESA real + SG03-random-EESA (D-032), the size-matched control for SR05-EESA: 880 untargeted pair texts generated for EESA; 7 BERTs, 3 seeds. Member = <classifier>_<generator>.",
    "SR02-EESA-XFER": "TRANSFER RUN, not an EESA result (D-032 revised): EESA real + SG01 subset (D-032): EESA train + 1,320 SG01 texts (110 per variety x sentiment cell, 22% of the set, so synthetic = 0.54 x real as in SR02), from one generator; 7 BERTs, 3 seeds. Member = <classifier>_<generator>. Stopped 2026-11-08 07:08 after 15 runs (seed 42, MARBERTv2 and MARBERT); renamed from sr0N_eesa_* (results/sentiment/renames_2026-11-08.json).",
    "SR05-EESA-XFER": "TRANSFER RUN, not an EESA result (D-032 revised): EESA real + SG03 subset (D-032): EESA train + 880 SG03 texts (440 whole pairs, pair types in SR05 shares; synthetic = 0.36 x real as in SR05); 7 BERTs, 3 seeds. SG03 targets ArSarcasm-v2 dev hard cases, not EESA. Member = <classifier>_<generator>. Stopped 2026-11-08 07:08 after 15 runs (seed 42, MARBERTv2 and MARBERT); renamed from sr0N_eesa_* (results/sentiment/renames_2026-11-08.json).",
    "SR06-EESA-XFER": "TRANSFER RUN, not an EESA result (D-032 revised): EESA real + SG03-random subset (D-032), the size-matched control for SR05-EESA: EESA train + 880 SG03-random texts (440 whole pairs, 0.36 x real); 7 BERTs, 3 seeds. Member = <classifier>_<generator>. Stopped 2026-11-08 07:08 after 15 runs (seed 42, MARBERTv2 and MARBERT); renamed from sr0N_eesa_* (results/sentiment/renames_2026-11-08.json)."
  },
