{
  "set_name": "sg04pn_fanar",
  "mode": "targeted",
  "condition": "controlled",
  "generator": "QCRI/Fanar-1-9B-Instruct",
  "cache_dir": "F:/Thesis/models",
  "quantization": "nf4",
  "template": "prompts/sentiment/pairs_targeted_v2.json",
  "plan_template": "prompts/sentiment/pairs_targeted_v2_posneg.json",
  "seed_source": "data/processed/sentiment/arsarcasm_v2_train.jsonl",
  "scale": 1.15,
  "batch_size": 4,
  "seed": 42,
  "sampling": {
    "temperature": 1.0,
    "top_p": 0.95,
    "top_k": 50,
    "max_new_tokens": 160,
    "repetition_penalty": 1.0,
    "do_sample": true
  },
  "output": "data/synthetic/sentiment/sg04pn_fanar_new.jsonl",
  "_notes": "SG04-PN (D-027, test-contaminated): new sarcastic praise and emoji pairs, same prompts, sampling and batch size as SG04. Pooled with the old SG04 pairs by src.sentiment.sg04pn."
}
